{
  "name": "steambandage",
  "productName": "SteamBandage",
  "version": "0.1.0",
  "description": "Farmeador de cromos de Steam con UI vamp minimalista",
  "author": "tomikav",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,app -c magenta,red \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV=1 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder --win",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "steam-user": "^5.2.0",
    "steamcommunity": "^3.50.0"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.0.0",
    "@fontsource/inter": "^5.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.tomikav.steambandage",
    "productName": "SteamBandage",
    "files": [
      "electron/**",
      "dist/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "release"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tomikav/steambandage.git"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "steam-appticket": {
      "protobufjs": "^7.6.6"
    }
  }
}
